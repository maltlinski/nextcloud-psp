{
  "name": "psp",
  "version": "0.1.0",
  "description": "Projektstrukturplan (work breakdown structure) app for Nextcloud",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "stylelint": "stylelint \"src/**/*.vue\" --allow-empty-input",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/vue": "^9.8.2",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/stylelint-config": "^3.1.1",
    "@nextcloud/vite-config": "^2.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  }
}
